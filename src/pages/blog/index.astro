---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Blog" description="Articles and working notes on petroleum engineering, research methodology and building research tools.">
  <div class="page-header">
    <h1>Blog</h1>
    <p>Articles and working notes. <a href="/rss.xml">Subscribe by RSS</a>.</p>
  </div>

  {
    tags.length > 0 && (
      <nav class="tag-nav" aria-label="Browse by tag">
        {tags.map((t) => (
          <a href={`/blog/tags/${t}/`} class="badge">
            {t}
          </a>
        ))}
      </nav>
    )
  }

  {
    posts.length === 0 ? (
      <p class="empty-state">No posts yet.</p>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li>
            <article>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {post.data.tags.length > 0 && (
                  <>
                    {' · '}
                    {post.data.tags.join(', ')}
                  </>
                )}
              </p>
              <p class="post-desc">{post.data.description}</p>
            </article>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>

<style>
  .tag-nav { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 2.5rem; }
  .tag-nav a { text-decoration: none; }
  .tag-nav a:hover { border-color: var(--accent); color: var(--accent); }

  .post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; }
  .post-list h2 { font-size: 1.3rem; margin: 0 0 0.3rem; }
  .post-list h2 a { color: var(--text); text-decoration: none; }
  .post-list h2 a:hover { color: var(--accent); text-decoration: underline; }
  .post-meta { font-size: 0.875rem; color: var(--text-muted); margin: 0 0 0.4rem; }
  .post-desc { margin: 0; max-width: var(--measure); color: var(--text-muted); }
</style>
